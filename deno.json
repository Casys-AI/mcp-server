{
  "workspace": [
    "./packages/server",
    "./packages/compose",
    "./packages/bridge",
    "./packages/view"
  ],
  "tasks": {
    "test": "deno task --filter '@casys/*' test",
    "check": "deno task --filter '@casys/*' check",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "ci": "deno fmt --check && deno lint && deno task check && deno task test"
  }
}
