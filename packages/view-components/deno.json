{
  "name": "@casys/mcp-view-components",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./preact": "./preact.ts",
    "./preact/components": "./preact-components.ts",
    "./scaffold": "./scaffold.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "preact.ts",
      "preact-components.ts",
      "scaffold.ts",
      "src/**/*.ts",
      "src/**/*.tsx",
      "README.md",
      "LICENSE"
    ],
    "exclude": ["**/*_test.ts", "**/*_test.tsx"]
  },
  "tasks": {
    "build:npm": "deno run -A scripts/build-npm.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env src/ preact_components_test.ts scaffold_test.ts",
    "check": "deno check mod.ts preact.ts preact-components.ts scaffold.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "release:check": "deno task check && deno task lint && deno task test && deno task publish:check"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "exclude": ["dist-node"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "deno.window", "dom", "dom.iterable", "dom.asynciterable", "esnext"]
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.1.0",
    "preact": "npm:preact@^10.28.3"
  }
}
